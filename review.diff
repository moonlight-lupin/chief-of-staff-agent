+def _audit_action(config: Any, action: Mapping[str, Any], status: str, extra: dict[str, Any] | None = None) -> None:
+    try:
+        from workspace_audit import audit_workspace_action
+        payload = {"action_id": action.get("id", "")}
+        if extra:
+            payload.update(extra)
