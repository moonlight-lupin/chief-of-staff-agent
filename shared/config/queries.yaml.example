# Chief of Staff — Gmail Query Templates
# Copy to shared/config/queries.yaml and customize.
# Fields with {client_name}, {contact_email}, etc. are template variables
# replaced at query time by the Daily Briefing skill.
#
# DIALECT: these `query:` strings are written in Gmail search syntax. When the
# configured workspace provider is Microsoft 365, they are AUTO-TRANSLATED to
# Graph $filter/$search by shared/scripts/query_compiler.py (parse_gmail_query
# -> compile_query(..., "m365")); no separate m365 query file is needed.
#
# COMPOSIO OUTLOOK LIMITATION: the default Microsoft Composio mail_search slug
# (OUTLOOK_QUERY_EMAILS) does NOT support text search / KQL. Queries that
# include text constraints (subject:, from: domain phrases, free-text OR
# groups, etc.) are broadened to filter-only OData (folder + recoverable
# filters). The daily briefing marks the Gmail section as status: degraded
# when this happens. Override integrations.workspace.tool_slugs.mail_search to
# a KQL-capable Composio slug (or set mail_search_supports_text_search: true)
# when one becomes available.

queries:
  - name: "unread_priority"
    description: "Unread messages likely to need same-day attention"
    query: 'in:inbox is:unread newer_than:14d ("urgent" OR "approval" OR "please review" OR "action required" OR "deadline")'
    max: 25

  - name: "unread_business"
    description: "Unread emails to business address"
    query: 'to:{delegate_email} is:unread'
    max: 15

  - name: "recent_unread"
    description: "Catch-all for recent unread, triage by sender"
    query: 'is:unread newer_than:3d label:INBOX'
    max: 20

  - name: "engagement_threads"
    description: "Track ongoing engagement threads"
    query: 'subject:(proposal OR NDA OR SOW OR invoice OR contract OR engagement OR "statement of work") newer_than:14d'
    max: 15

  - name: "client_documents"
    description: "Documents from clients with attachments"
    query: 'has:attachment newer_than:7d'
    max: 10

  - name: "sent_followup"
    description: "Emails sent that may not have received a reply"
    query: 'from:{delegate_email} newer_than:7d'
    max: 10

  - name: "acra_iras"
    description: "Government/regulatory correspondence"
    query: 'from:(@acra.gov.sg OR @iras.gov.sg OR @bizfile.gov.sg) newer_than:30d'
    max: 10

  - name: "proposal_followup"
    description: "Check if client has responded to proposal (template query)"
    query: '{client_name} newer_than:14d'
    max: 5
    template: true

  - name: "invoice_payment"
    description: "Track payment status (template query)"
    query: 'subject:invoice {client_name} newer_than:30d'
    max: 5
    template: true

triage_rules:
  - signal: "From client + unread + > 2 days old"
    action: "Flag as needs response"
    icon: "red"
  - signal: "Subject contains proposal/NDA/SOW/contract"
    action: "Track in pipeline section"
    icon: "chart"
  - signal: "From government domain"
    action: "Include in deadline section"
    icon: "clock"
  - signal: "Has attachment from client"
    action: "Note in briefing, suggest filing"
    icon: "paperclip"
  - signal: "Sent email + no reply in 7 days"
    action: "Flag as follow up needed"
    icon: "repeat"