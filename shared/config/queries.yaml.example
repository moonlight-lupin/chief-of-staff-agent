# Chief of Staff — Gmail query templates
# Copy to shared/config/queries.yaml and customize. Templates can use fields such
# as {client_name}, {contact_email}, {domain}, {invoice_id}, and {days}.

queries:
  briefing_unread_priority:
    description: Unread messages likely to need same-day attention.
    query: 'in:inbox is:unread newer_than:14d ("urgent" OR "approval" OR "please review" OR "action required" OR "deadline")'
    max_results: 25

  briefing_unread_clients:
    description: Recent unread client or prospect mail.
    query: 'in:inbox is:unread newer_than:30d ({client_name} OR from:{contact_email})'
    max_results: 20

  client_recent_threads:
    description: Recent client context for Meeting Prep and Pipeline Manager.
    query: 'newer_than:90d ({client_name} OR from:{contact_email} OR to:{contact_email})'
    max_results: 50

  client_attachments:
    description: Client mail with attachments for Drive Filer suggestions.
    query: 'newer_than:180d has:attachment ({client_name} OR from:{contact_email} OR to:{contact_email})'
    max_results: 50

  documents_for_signature:
    description: Documents that may need self-signing.
    query: 'newer_than:60d has:attachment ("please sign" OR "for signature" OR "signature required" OR "sign and return")'
    max_results: 25

  invoices_received:
    description: Supplier invoices and bills for Bookkeeper AP intake.
    query: 'newer_than:90d has:attachment (invoice OR bill OR receipt OR statement) -from:me'
    max_results: 50

  invoices_sent_followup:
    description: Sent invoices that may need AR follow-up.
    query: 'in:sent newer_than:180d ({client_name} OR to:{contact_email}) (invoice OR "payment due" OR "tax invoice")'
    max_results: 50

  meeting_action_items:
    description: Action items from recent meeting follow-ups.
    query: 'newer_than:60d ({client_name} OR from:{contact_email} OR to:{contact_email}) ("action item" OR "next steps" OR "follow up" OR "to do")'
    max_results: 30

  compliance_notices:
    description: Statutory notices from filing authorities.
    query: 'newer_than:365d (from:acra.gov.sg OR from:iras.gov.sg OR from:ird.gov.hk OR from:companieshouse.gov.uk OR from:hmrc.gov.uk OR from:irs.gov)'
    max_results: 50

  travel_confirmations:
    description: Travel confirmations for itinerary building and expense capture.
    query: 'newer_than:365d has:attachment (flight OR hotel OR itinerary OR booking OR "boarding pass" OR "e-ticket")'
    max_results: 50
