# Chief of Staff — Company Configuration
# Copy this file to shared/config/company.yaml and edit for the company using
# the plugin. Data files referenced by the skills live under paths.project_root.

company:
  # Legal trading or registered company name used in documents and reports.
  name: "Acme Advisory Pte Ltd"
  # Supported jurisdiction packs: SG, HK, US, UK.
  jurisdiction: SG
  # Incorporation/formation date in ISO format. Used for anniversary deadlines.
  incorporation_date: "2024-01-15"
  # Financial year end as "DD Mon" or full ISO date. Used for annual statutory deadlines.
  financial_year_end: "31 Dec"
  # Primary reporting currency for pipeline, invoices, expenses, and P&L.
  currency: SGD
  # Used to seed wiki taxonomy, template suggestions, and role-based signing hints.
  business_type: "professional_services"
  # Optional identifiers included in generated documents where relevant.
  registration_number: "202400001A"
  tax_registration_number: "M90000001A"
  address: "1 Raffles Place, #20-01, Singapore 048616"
  phone: "+65 6123 4567"
  website: "https://www.acme-advisory.example"

user:
  # Primary operator/founder who receives briefings and signs documents.
  name: "Alicia Tan"
  role: "Managing Director"
  email: "alicia@acme-advisory.example"
  phone: "+65 9123 4567"

# Google Workspace integration.
# Actual Google auth is performed by the external google-workspace skill via google_api.py.
# Chief-of-Staff calls google_api.py through GoogleWorkspaceClient with --account and --as flags.
google:
  # Service account JSON with domain-wide delegation.
  # Checked by Chief-of-Staff doctor/setup. Must exist for service-account auth.
  service_account_path: "~/.hermes/secrets/acme-google-service-account.json"
  # Workspace domain.
  domain: "acme-advisory.example"
  # Delegated user — passed to google_api.py as --as for impersonation.
  delegate_email: "alicia@acme-advisory.example"
  # Account alias — passed to google_api.py as --account.
  # Must match the account configured in google_api.py (e.g. "phronesis", "acme-advisory").
  account_alias: "acme-advisory"
  # Root Drive folder ID for the numbered folder structure.
  drive_root_folder_id: "1A2B3C4D5E6F_example_root_id"

paths:
  # Project root stores YAML data files: pipeline.yaml, todos.yaml, invoices.yaml, expenses.yaml.
  # The default uses ~/.hermes but you can set CHIEF_OF_STAFF_HERMES_HOME or HERMES_HOME
  # to relocate the entire home directory for non-Hermes agents (e.g. OpenClaw).
  project_root: "~/.hermes/projects/acme-advisory/"
  # Wiki path for the Note Taker / second-brain skill.
  wiki_path: "~/.hermes/projects/acme-advisory/wiki/"
  # Local template directory bundled with the plugin or customized per customer.
  templates: "~/.hermes/plugins/chief-of-staff/shared/templates/"
  # Optional downloads/staging directory for Drive Filer and document workflows.
  staging: "~/.hermes/projects/acme-advisory/staging/"

# Delivery preferences for scheduled agent outputs.
delivery:
  channel: telegram            # telegram | whatsapp | email | slack | cli
  home_chat_id: "123456789"    # platform-specific; omit if using CLI only
  briefing_time: "20:00"       # 24-hour local time
  weekly_review_day: friday
  weekly_review_time: "17:00"
  timezone: "Asia/Singapore"
  use_client_codes: false      # set true if messages may be seen by others

# CRM pipeline stages used by Pipeline Manager. Keep names stable once data exists.
sales_stages:
  - Lead
  - Qualified
  - Proposal Sent
  - NDA Signed
  - Contract Sent
  - Contract Signed
  - Invoiced
  - Paid
  - Lost
# Deals with no activity in their current stage for this many days are stale.
stale_threshold_days: 14

# Deadline Tracker reads statutory deadlines from jurisdictions/{jurisdiction}.yaml
# and merges these custom business-specific dates.
deadlines:
  custom:
    - name: "Professional indemnity insurance renewal"
      due: "2026-09-30"
      authority: "Internal"
      notes: "Renew before the existing policy lapses."
      owner: "Alicia Tan"
    - name: "Major client framework review"
      due: "2026-11-15"
      authority: "Commercial"
      notes: "Review pricing and deliverables before renewal discussion."
      owner: "Alicia Tan"

calendar:
  # Minutes before meetings for auto-generated prep prompts.
  reminder_minutes: 15
  # If true, Calendar Manager asks Meeting Prep to generate briefs automatically.
  auto_prep_brief: true
  # Working days/hours used for scheduling suggestions.
  working_days: [monday, tuesday, wednesday, thursday, friday]
  working_hours:
    start: "09:00"
    end: "18:00"

self_sign:
  # Signature assets are copied here during onboarding. Keep paths relative to plugin root or absolute.
  signature_image: "shared/assets/signature.png"
  initials_image: "shared/assets/initials.png"
  company_stamp: "shared/assets/stamp.png"
  auto_date: true
  output_format: pdf
  party_aliases:
    - "Service Provider"
    - "Consultant"
    - "Contractor"
    - "The Company"
  detection_patterns:
    signature:
      - "Signature:"
      - "Signed by:"
      - "Authorised Signatory:"
      - "For and on behalf of"
      - "______________"
    date:
      - "Date:"
      - "Date Signed:"
    party:
      - "The Client"
      - "The Service Provider"
      - "Party A"
      - "Party B"

bookkeeper:
  # Report defaults. Actual records live in paths.project_root/invoices.yaml and expenses.yaml.
  revenue_recognition: cash     # cash = paid invoices only for P&L
  default_payment_terms_days: 14
  expense_categories:
    - software
    - rent
    - utilities
    - travel
    - meals
    - professional
    - equipment
    - tax
    - other

backup:
  enabled: true
  schedule: "0 3 * * 0"        # Sunday 03:00 local time
  retention_weekly: 4
  retention_monthly: 12
  drive_folder: "09_Backups/"
  exclude:
    - ".env"
    - "auth.json"
    - "state.db"
    - "sessions/"
    - "logs/"

integrations:
  workspace:
    provider: google_api        # google_api | composio | m365
    mode: direct                # direct | sdk | mcp
    user_id: null
    account_aliases:
      gmail: null
      googlecalendar: null
      googledrive: null
    toolkits:
      - gmail
      - googlecalendar
      - googledrive
    tools_allowlist:
      gmail:
        read:
          - GMAIL_FETCH_EMAILS
        write_safe:
          - GMAIL_CREATE_EMAIL_DRAFT
      googlecalendar:
        read:
          - GOOGLECALENDAR_FIND_EVENT
        write_safe:
          - GOOGLECALENDAR_CREATE_EVENT
      googledrive:
        read:
          - GOOGLEDRIVE_FIND_FILE
          - GOOGLEDRIVE_DOWNLOAD_FILE
        write_safe:
          - GOOGLEDRIVE_UPLOAD_FILE

# eSign Connector — DocuSeal self-hosted integration.
# Secrets live in .env (DOCUSEAL_MCP_TOKEN, DOCUSEAL_API_KEY), NOT here.
esign:
  # Provider name — future providers (docusign, signnow) slot in as siblings.
  provider: docuseal
  # Self-hosted instance URL (used for both MCP and REST API calls).
  url: "https://sign.yourdomain.com"
  # Domain shown in signing links (set in DocuSeal HOST env).
  domain: "sign.yourdomain.com"
  # Email of the provider's signer (the company's representative).
  provider_email: "you@yourdomain.com"
  # Role labels used in DocuSeal submissions.
  provider_role: "Service Provider"
  client_role: "Client"
  # Auth mode: auto (MCP + API key, CE free) | mcp_and_api (same as auto) | pro_api_only (API key only, requires Pro).
  auth_mode: auto
  # How PDFs are served to MCP create_template (needs HTTPS URL).
  file_serving:
    # existing = customer already hosts files at a reachable HTTPS URL.
    # local_https = not yet implemented (planned for future release).
    mode: existing
    public_base_url: null    # e.g. "https://files.yourdomain.com"
    cleanup_after_send: true
  # Default submission behaviour.
  defaults:
    signing_order: random    # random = simultaneous | preserved = sequential
    cancel_before_resend: true
  # Signature field detection configuration.
  field_detection:
    prefer: auto            # auto | table | underscore
    page_indexing: zero_based
